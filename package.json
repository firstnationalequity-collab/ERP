{
  "name": "albert-erp",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:up": "docker compose up -d db",
    "db:migrate": "pnpm --filter @albert/api db:migrate",
    "db:seed": "pnpm --filter @albert/api db:seed",
    "db:seed:dev": "pnpm --filter @albert/api db:seed:dev"
  }
}
