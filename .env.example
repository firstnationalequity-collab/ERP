# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://albert:albert@localhost:5432/albert_erp
DATABASE_URL_TEST=postgres://albert:albert@localhost:5432/albert_erp_test
JWT_ACCESS_SECRET=change-me-at-least-32-characters-long-xxxx
JWT_REFRESH_SECRET=change-me-too-at-least-32-characters-xxxx
CORS_ORIGIN=http://localhost:5173
COMPANY_TIMEZONE=Asia/Karachi

# First admin user created by pnpm db:seed (forced change at first login). Required in production.
INITIAL_ADMIN_PASSWORD=
# Development only: password of the demo users made by pnpm db:seed:dev (one per role, no forced change).
# The command refuses unless NODE_ENV=development and the database name does not contain "prod". Never set in production.
DEV_DEMO_PASSWORD=
# Local-disk attachment storage (S3 driver comes in M10)
STORAGE_DIR=./storage

# FBR Digital Invoicing (PRAL) — sandbox first
FBR_MODE=sandbox
FBR_API_URL=
FBR_API_TOKEN=
