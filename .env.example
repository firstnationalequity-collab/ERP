# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://albert:albert@localhost:5432/albert_erp
DATABASE_URL_TEST=postgres://albert:albert@localhost:5432/albert_erp_test
JWT_ACCESS_SECRET=change-me-at-least-32-characters-long-xxxx
JWT_REFRESH_SECRET=change-me-too-at-least-32-characters-xxxx
